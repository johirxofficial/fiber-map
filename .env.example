# Copy this file to .env (or export these values in your hosting panel).
# Do not commit real passwords or production keys.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=example.com,www.example.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Optional HTTPS hardening. Leave these unset for a plain-HTTP install.
# Enable them when Nginx/Apache terminates TLS in front of the app.
# DJANGO_TRUST_X_FORWARDED_PROTO=1
# DJANGO_SECURE_COOKIES=1
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000

# MySQL / MariaDB.  The setup wizard can also write these to site_config.json.
DB_ENGINE=mysql
DB_NAME=fiber_map
DB_USER=fibermap
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional: point to a writable config file outside the code directory.
# SITE_CONFIG_FILE=/opt/fiber-map/site_config.json
